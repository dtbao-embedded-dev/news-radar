# skill-support-commit local files
.claude/gitconfig.yml
.claude/commit-backup.json

# Real config and secrets - templates are committed, these are not.
# frequency_words.txt is here for a different reason than the two below it: not
# because it holds a secret, but because `git checkout <tag>` overwrites a
# tracked file, and a deployment's tuned keyword groups are not something a
# deploy may quietly revert.
config/config.yaml
config/frequency_words.txt
docker/.env
docker/tunnel-credentials.json

# Derived data: crawl output, rendered pages, SQLite store
output/

# Dated copies of the store. Never under output/ - that directory is public.
backups/

# Python
__pycache__/
*.py[cod]
.venv/

# Local tooling logs
.eaaw/
