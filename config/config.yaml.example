# news-radar configuration.
# Copy to config/config.yaml (scripts/setup.py does this for you) and edit.
# Secrets never live here - they live in docker/.env. See
# docs/memory-ai/interface/config-and-env.md for every key and its default.

app:
  timezone: Asia/Ho_Chi_Minh

schedule:
  # 10 is what ships; the code default is 30, so a config that never mentions
  # this key keeps the half-hour it already had. One cycle costs 35-57s for the
  # 22 requests the shipped feed list makes, so ten minutes still leaves the
  # process idle most of the time - but it is three times the traffic at Google
  # News and HN Algolia, and those are the two that throttle first.
  interval_minutes: 10
  run_on_start: true

# Fixed feeds: fetched whole every run, then matched locally.
#
# Per-entry keys: id, name, url, enabled (default true), rank_weight
# (default 1.0) and match_excerpt (default false).
#
# match_excerpt: true makes the keyword match - and the group's own ! terms and
# [GLOBAL_FILTER] with it - read the entry's description as well as its title.
# Leave it off. It exists for one shape of source: a feed whose titles carry no
# words, like GitHub trending, where every entry is titled `owner/repo` and the
# description holds the only text worth matching. Measured across twelve live
# sources, switching it on everywhere found 42% more matches and the extras
# were stories that merely mention a keyword once in the body.
feeds:
  - id: hn
    name: Hacker News
    url: https://hnrss.org/frontpage
    enabled: true
    rank_weight: 1.0
  - id: lobsters
    name: Lobsters
    url: https://lobste.rs/rss
    enabled: true
    rank_weight: 1.0
  - id: hackaday
    name: Hackaday
    url: https://hackaday.com/blog/feed/
    enabled: true
    rank_weight: 0.9
  - id: lwn
    name: LWN
    url: https://lwn.net/headlines/rss
    enabled: true
    rank_weight: 0.9
  # If this one answers "Name or service not known", the resolver is the
  # problem and not Reddit: `www.reddit.com` failed to resolve on this homelab's
  # host *and* in the container until the crawl service was given its own
  # nameservers in docker-compose.yml. `old.reddit.com` is not the workaround it
  # looks like - it resolves and then serves 350 kB of HTML instead of the feed.
  - id: r_embedded
    name: r/embedded
    url: https://www.reddit.com/r/embedded/.rss
    enabled: true
    rank_weight: 0.8
  - id: vnexpress_sohoa
    name: VnExpress So hoa
    url: https://vnexpress.net/rss/so-hoa.rss
    enabled: true
    rank_weight: 0.7
  - id: genk
    name: GenK
    url: https://genk.vn/rss/home.rss
    enabled: true
    rank_weight: 0.6
  - id: tinhte
    name: Tinh te
    url: https://tinhte.vn/rss
    enabled: true
    rank_weight: 0.6

  # GitHub trending, via a third-party RSS mirror - GitHub publishes no feed of
  # its own for it. The only feed here that needs match_excerpt: every entry is
  # titled `owner/repo` and the description carries the only matchable text.
  # Measured 2026-09-07: 1 of 18 entries matched on the title, 10 with the
  # excerpt. It also ships **no dates**, so its freshness term is always 0 and
  # rank_weight is its entire score: 0.5 x weight, nothing else. Measured at
  # 0.7 it scored 0.35 and did not make a single group; 1.0 scores 0.50, which
  # is what it takes to sit among dated stories at all.
  - id: gh_trending
    name: GitHub Trending
    url: https://mshibanami.github.io/GitHubTrendingRSS/daily/all.xml
    enabled: true
    rank_weight: 1.0
    match_excerpt: true

  # OpenAI's own announcements. A primary source - when it says something, it is
  # the thing every other AI feed is about to report second-hand.
  - id: openai
    name: OpenAI News
    url: https://openai.com/news/rss.xml
    enabled: true
    rank_weight: 1.0

  # Hugging Face's blog: releases, model cards and write-ups. Note it carries no
  # descriptions at all, so match_excerpt would do nothing here even if set.
  - id: huggingface
    name: Hugging Face Blog
    url: https://huggingface.co/blog/feed.xml
    enabled: true
    rank_weight: 0.9

  # ESP-IDF releases, straight from the tag. Weighted below the news sources on
  # purpose: the feed always holds the same ten releases, old point releases
  # included, and a release from five days ago has no freshness left at a 12 h
  # half-life - so at 1.0 all ten scored 0.50 and took ten of the ESP32 group's
  # twelve slots, turning a news section into a changelog.
  - id: esp_idf_releases
    name: ESP-IDF Releases
    url: https://github.com/espressif/esp-idf/releases.atom
    enabled: true
    rank_weight: 0.8

  # CNX Software's ESP32 tag - single-board and microcontroller news, already
  # narrowed by the source. Measured 27 of 32 entries matching a shipped group.
  - id: cnx_esp32
    name: CNX Software (ESP32)
    url: https://www.cnx-software.com/tag/esp32/feed/
    enabled: true
    rank_weight: 0.9

# Search feeds: {kw} is replaced by each keyword group's primary term.
# Cost per run is len(groups) x len(enabled templates) - six groups and the
# three enabled below is 18 requests, on top of the eight fixed feeds. Keep
# that in mind before enabling the fourth.
search_templates:
  # `when:7d` is the whole reason this template earns its slot. Google News
  # answers relevance-first: without a window it returns hits aged months,
  # which score 0 for freshness and leave the group ordered by source weight
  # alone. Widen it and the page goes stale, not fuller.
  - id: google_news
    name: Google News (vi)
    url: "https://news.google.com/rss/search?q={kw}+when:7d&hl=vi&gl=VN&ceid=VN:vi"
    format: rss
    enabled: true
    rank_weight: 0.8
  # The same engine in English, and it is not a duplicate: the locale decides
  # which press is searched at all. Measured on 2026-09-05 over the six shipped
  # groups, `hl=vi` returned 48 usable stories and every one of them was in the
  # AI group - the Vietnamese press does not write about ESP32, RTOS or RISC-V.
  # `hl=en` returned 218 across all six. Keeping both costs one request per
  # group per cycle and is what keeps Vietnamese AI coverage on the page.
  - id: google_news_en
    name: Google News (en)
    url: "https://news.google.com/rss/search?q={kw}+when:7d&hl=en&gl=US&ceid=US:en"
    format: rss
    enabled: true
    rank_weight: 0.8
  # `typoTolerance=false` is not a nicety. Algolia's default typo tolerance
  # matches 41,612 stories for `RTOS` and `FreeToken` for `FreeRTOS`, and
  # search_by_date then returns the most recent of that noise - RTOS came back
  # 0 usable of 20. Turning it off is strictly better on every shipped group:
  # 97 usable stories a cycle instead of 77, measured 2026-09-05.
  - id: hn_algolia
    name: Hacker News search
    url: "https://hn.algolia.com/api/v1/search_by_date?query={kw}&tags=story&typoTolerance=false"
    format: hn_algolia_json
    enabled: true
    rank_weight: 0.8
  # Disabled by default: it duplicates the fixed r/embedded feed heavily.
  - id: reddit_search
    name: Reddit search
    url: "https://www.reddit.com/search.rss?q={kw}&sort=new"
    format: atom
    enabled: false
    rank_weight: 0.6

keywords:
  file: config/frequency_words.txt

report:
  # daily reads the whole local day - the same window the page renders - and
  # subtracts what this channel has already been told, so the phone and the page
  # agree on which stories exist. incremental reads only this run, which means a
  # story missed by one refused cycle is never offered again.
  mode: daily            # incremental | current | daily
  max_per_group: 0       # 0 = unlimited; a group's own @n wins over this
  rank_threshold: 5      # the first N of each group are highlighted on the page

  # The HTML report. false is what ships: Telegram and Discord already carry
  # every story, and a second copy of the same day on a web server is one more
  # thing to keep reachable and correct. Turning it off also *deletes*
  # output/index.html and output/days/*.html on the next cycle, so the web
  # server has nothing left to serve - a frozen page reads as "no news" rather
  # than "the page is off". The store is never touched, and ops.site_url stops
  # being checked. The code default is true, so an upgrade that says nothing
  # here keeps publishing.
  html: false

rank:
  weight_source: 0.5
  weight_frequency: 0.3
  weight_freshness: 0.2
  freshness_half_life_hours: 12

storage:
  data_dir: output
  # 0 = keep everything. 90 is what ships: the store and output/days/ otherwise
  # grow forever, and an unattended radar with no ceiling is a disk that fills
  # on a weekend. A backup is written immediately before each prune.
  retention_days: 90

# Keeping it alive without babysitting.
ops:
  # Dead-man's switch. GET after every clean cycle - a healthchecks.io ping url
  # or an Uptime Kuma push url. Empty means no ping at all, which is the right
  # default for a clone that has no monitor of its own yet.
  #   heartbeat_url: https://hc-ping.com/<uuid>
  heartbeat_url: ""

  # Checked immediately before the ping. A non-200 withholds the ping and counts
  # as a failed cycle - it is what notices the web server having stopped serving
  # while the crawl itself keeps running perfectly. `caddy` resolves over the
  # compose network, so this needs nothing published and no name outside.
  #   site_url: http://caddy:8080/
  site_url: ""

  # Never under data_dir: that directory is served to the public web.
  backup_dir: backups
  backup_keep: 7         # one file per day, newest N kept; 0 = no backup

ai:
  # The one thing in this file that costs money, so it ships off. On, it writes
  # one sentence under each story - on the page and in the notification, the
  # same sentence in both - saying what the story is about and why it is worth
  # opening. The sentence is written from the headline and the source's own
  # description, once per story, and kept in the store: a story on the page all
  # day costs one completion, not one every cycle.
  enabled: false

  # The OpenAI *wire format*, not the vendor. Anything that answers
  # /v1/chat/completions works, and one of them has no bill:
  #   api_url: https://openrouter.ai/api/v1/chat/completions
  #   api_url: https://api.deepseek.com/v1/chat/completions
  #   api_url: http://ollama:11434/v1/chat/completions   # local, no key needed
  api_url: https://api.openai.com/v1/chat/completions
  model: gpt-4o-mini

  # OPENAI_API_KEY in docker/.env, and only if the endpoint wants one. A
  # server on your own LAN authenticates nobody, so leave the key unset and no
  # Authorization header is sent at all. A hosted endpoint with no key set
  # answers 401, which is logged every cycle rather than failing startup.

  # Stories one cycle will pay to summarise. Everything above the cap waits for
  # the next cycle, so a first run against a store full of yesterday's stories
  # spreads the backlog over an hour instead of sending one enormous prompt.
  max_per_run: 20
  # A completion is slower than a feed; 15s is not enough. 60 suits a hosted
  # small model - a self-hosted 27B on one box measured ~95s, so raise this
  # rather than wonder why every summary "times out".
  timeout_s: 60

notification:
  enabled: true
  channels:
    telegram:
      enabled: true      # needs TELEGRAM_BOT_TOKEN and TELEGRAM_CHAT_ID
    discord:
      enabled: true      # needs DISCORD_WEBHOOK_URL

advanced:
  request_interval_ms: 2000    # minimum gap between two requests to one host
  request_timeout_s: 15        # the only bound on a hung run - never unset it
  max_retries: 2
  user_agent: "news-radar/{version} (+https://news.dtbao.org)"
  debug: false
