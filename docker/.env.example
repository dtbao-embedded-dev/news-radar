# news-radar secrets. Copy to docker/.env (scripts/setup.py does this for you).
# docker/.env is gitignored - never commit a real token.

# Telegram: create a bot with @BotFather, then read the chat id from
# https://api.telegram.org/bot<TOKEN>/getUpdates after messaging the bot once.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Discord: channel settings -> Integrations -> Webhooks -> New Webhook -> Copy URL
DISCORD_WEBHOOK_URL=

# AI summary. Only read when ai.enabled is true in config.yaml, and only needed
# if the endpoint wants one - a server on your own LAN usually does not, and
# leaving this empty sends no Authorization header at all. The endpoint itself
# is ai.api_url in config.yaml; this is only the key.
OPENAI_API_KEY=

# Container clock. Rendering still honours app.timezone in config.yaml.
TZ=Asia/Ho_Chi_Minh

# Host port Caddy is published on for local debugging. The Cloudflare Tunnel
# uses caddy:8080 on the docker network and ignores this. Change it if the
# default collides with something else on the host.
NEWS_RADAR_HTTP_PORT=8088

# Where this deployment's own files live - config/, output/ and backups/ -
# resolved relative to docker-compose.yml. Leave it empty in a dev checkout: the
# compose default is `..`, the repository root, which is where they already are.
# A deployment directory sets it to `.`, so the data sits beside the compose
# file with no git checkout anywhere near it. Nothing an update runs can then
# reach these directories.
NEWS_RADAR_HOME=

# Which published image to run. Empty means `latest`, which is what auto-update
# follows. Pin a version here to freeze the deployment or to roll one back:
#   NEWS_RADAR_VERSION=0.2.2
# then `docker compose up -d`. Pinning is enough on its own: watchtower polls
# the tag the running container was created from, and a version tag does not
# move, so a pinned deployment is frozen even with the autoupdate profile on.
# The only way past it is republishing that same version tag, which a workflow
# re-run would do - leave the profile off too if that worries you.
NEWS_RADAR_VERSION=

# How often watchtower asks GHCR whether there is a newer :latest, in seconds.
# Only read when the stack is started with --profile autoupdate. 86400 is once
# a day, which is more often than this project cuts releases.
WATCHTOWER_POLL_INTERVAL=86400
